# --- Core ---
PORT=4000
PUBLIC_URL=http://localhost:4000          # Public https URL in production (Printful downloads designs from it)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/brain
ADMIN_TOKEN=change-me-to-a-long-random-string
TIMEZONE=Europe/Prague
STORAGE_DIR=./storage                     # Use a mounted volume in production

# Nothing is sent to Etsy/Printful and nothing is spent while true.
DRY_RUN=true

# --- Budget (EUR) ---
DAILY_API_BUDGET_EUR=5                    # Hard daily cap on Claude API spend
SPEND_APPROVAL_LIMIT_EUR=20               # Single spends above this need /approve
USD_TO_EUR=0.92

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Telegram (create a bot with @BotFather; chat id from @userinfobot) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Etsy (https://www.etsy.com/developers) ---
ETSY_API_KEY=                             # keystring
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_SHIPPING_PROFILE_ID=
ETSY_RETURN_POLICY_ID=
ETSY_TAXONOMY_ID=                         # Category id for mugs
ETSY_PRODUCTION_PARTNER_ID=               # Printful, as set up in Shop Manager
ETSY_AUTO_PUBLISH=false                   # false = ask for approval before paying listing fees

# --- Printful (https://developers.printful.com) ---
PRINTFUL_TOKEN=
PRINTFUL_STORE_ID=
PRINTFUL_PRODUCT_ID=                      # Look up with: npm run printful:catalog -- <id>
PRINTFUL_VARIANT_ID=
PRINTFUL_PLACEMENT=default

# --- Product ---
POD_PRICE_EUR=17.99
POD_CURRENCY=EUR
POD_LISTINGS_PER_RUN=5
POD_DESIGN_WIDTH=2700                     # Match the Printful print file size
POD_DESIGN_HEIGHT=1050
