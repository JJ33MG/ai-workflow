{
  "name": "ai-agency-brain",
  "version": "0.1.0",
  "description": "Shared AI brain: a team of business agents coordinated by a CEO agent.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "prisma migrate deploy && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "agent:run": "tsx src/cli.ts",
    "printful:catalog": "tsx src/scripts/printfulCatalog.ts",
    "launch-pack": "tsx src/scripts/exportLaunchPack.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
