generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per agent. `status` is updated by the runner on every run.
model Agent {
  id        String    @id // e.g. "ceo", "etsy-pod", "debug"
  name      String
  phase     Int
  enabled   Boolean   @default(true)
  status    String    @default("idle") // idle | running | error
  lastRunAt DateTime?
  lastError String?
  createdAt DateTime  @default(now())

  tasks     Task[]
  logs      Log[]
  costs     Cost[]
  sales     Sale[]
  knowledge Knowledge[]
}

/// Unit of work. Failed tasks are retried by the Debug Agent until maxAttempts.
model Task {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  type        String
  payload     Json      @default("{}")
  status      String    @default("pending") // pending | running | done | failed | escalated | dismissed
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@index([status, runAfter])
  @@index([agentId, createdAt])
}

model Log {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  level     String // info | warn | error
  message   String
  data      Json?
  taskId    String?
  resolved  Boolean  @default(false) // errors only; set by the Debug Agent
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
  @@index([level, resolved])
}

/// Money in. Amounts are stored in minor units (cents) of `currency`.
model Sale {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  source      String // etsy, shopify, ...
  externalId  String // e.g. Etsy receipt_id
  amountCents Int
  currency    String
  data        Json?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([source, externalId])
  @@index([occurredAt])
}

/// Money out: API usage, listing fees, fulfilment, ads.
model Cost {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  category    String // claude_api | etsy_fee | printful | ads | other
  amountCents Float // fractional: a single Claude call often costs < 1 cent
  currency    String
  note        String?
  data        Json?
  occurredAt  DateTime @default(now())

  @@index([occurredAt])
  @@index([category, occurredAt])
}

/// Shared brain: what sells, what works, what broke and how it was fixed.
model Knowledge {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  kind      String // niche | product | hook | fix | lesson
  title     String
  body      String
  tags      String[]
  score     Float    @default(0) // higher = more useful / proven
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, score])
}

/// Decisions Jarne must make (spend, new platforms, risky actions).
model Approval {
  id          String    @id @default(cuid())
  agentId     String
  kind        String // e.g. printful_order_confirm, etsy_publish
  title       String
  details     String
  amountCents Int?
  currency    String?
  payload     Json      @default("{}")
  status      String    @default("pending") // pending | approved | rejected | executed | failed
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([status])
}

/// A print-on-demand product created by the Etsy/POD Agent.
model Listing {
  id               String   @id @default(cuid())
  niche            String
  title            String
  description      String
  tags             String[]
  priceCents       Int
  currency         String
  designSvg        String
  designFile       String // file name under STORAGE_DIR/designs
  status           String   @default("draft") // draft | uploaded | active | ended | failed
  /// agent: made by the Etsy agent · etsy: found in the shop by sync (e.g. placed by hand via Printful)
  source           String   @default("agent")
  /// Main photo from Etsy, for listings the agent didn't design itself.
  imageUrl         String?
  etsyListingId    String?  @unique
  /// Etsy's own counters, refreshed by the hourly listing sync; the marketing agent measures with them.
  views            Int      @default(0)
  favorites        Int      @default(0)
  printfulVariant  Int?
  error            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Small key/value store (OAuth tokens, cursors).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Conversation between Jarne and one agent (the dashboard's Chat tab).
model ChatMessage {
  id        String   @id @default(cuid())
  agentId   String
  role      String // user | assistant
  content   String
  actions   Json? // what the agent did while answering, e.g. queued tasks
  createdAt DateTime @default(now())

  @@index([agentId, createdAt])
}

/// A coloring book made by the KDP agent, ready for manual upload to Amazon KDP.
model ColoringBook {
  id          String   @id @default(cuid())
  theme       String
  ageRange    String
  title       String
  subtitle    String
  author      String
  description String
  keywords    String[]
  categories  String[]
  pages       Json     @default("[]") // [{ subject, status, file }]
  pageCount   Int      @default(0) // pages in the interior PDF
  priceCents  Int
  currency    String
  status      String   @default("drawing") // drawing | ready | failed | published
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One marketing experiment of the marketing agent: a tactic tried on part of a business,
/// measured against the rest. What works is shared with the other businesses.
model MarketingPlay {
  id           String    @id @default(cuid())
  businessId   String
  /// Key of a tactic in src/lib/marketing.ts; "manual" = a step Jarne does himself.
  tactic       String
  title        String
  why          String
  /// For manual plays: what to do, step by step.
  instructions String    @default("")
  /// proposed | running | todo | measured | skipped | failed
  status       String    @default("proposed")
  /// Tactic input, e.g. { listingCount: 5 } or { niches: [...] }.
  input        Json?
  /// What the play changed and the numbers before, so it can be measured (and undone).
  baseline     Json?
  result       Json?
  /// worked | no_effect | worse | unclear
  verdict      String?
  liftPct      Float?
  note         String?
  /// The play in another business this one adapts.
  copiedFrom   String?
  startedAt    DateTime?
  measuredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([businessId, status])
}

/// A post the marketing agent placed on a social platform (e.g. a Pinterest pin for a listing).
model SocialPost {
  id         String   @id @default(cuid())
  platform   String // pinterest
  businessId String
  /// What it promotes, e.g. a Listing id.
  refId      String
  externalId String
  board      String?
  title      String
  link       String
  createdAt  DateTime @default(now())

  @@unique([platform, refId])
  @@index([businessId, createdAt])
}
